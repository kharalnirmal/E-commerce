DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chauk_test
BETTER_AUTH_SECRET=test-only-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
DEMO_MODE=true
DEMO_PASSWORD=demo-password-for-tests
ESEWA_GATEWAY_MODE=mock
APP_URL=http://localhost:3000
# UAT and production additionally require ESEWA_PRODUCT_CODE, ESEWA_SECRET,
